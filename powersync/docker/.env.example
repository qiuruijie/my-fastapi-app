# PowerSync 自托管 docker 环境变量模板
# 复制为 .env 后填入真实值；.env 与 private-key.json 均已 gitignore，切勿入库

# source MySQL（下行同步的数据源）
PS_DATABASE_NAME=digua_dev
PS_DATABASE_PASSWORD=changethis
PS_DATABASE_PORT=3306
PS_DATABASE_USER=repl_user
PS_DATA_SOURCE_URI=mysql://${PS_DATABASE_USER}:${PS_DATABASE_PASSWORD}@host.docker.internal:${PS_DATABASE_PORT}/${PS_DATABASE_NAME}

# storage PostgreSQL（PowerSync 内部缓存库）
PS_STORAGE_DATABASE=powersync_storage
PS_STORAGE_PASSWORD=changethis
PS_STORAGE_PORT=5432
PS_STORAGE_USER=postgres
PS_STORAGE_SOURCE_URI=postgresql://${PS_STORAGE_USER}:${PS_STORAGE_PASSWORD}@my-fastapi-app-db-1:${PS_STORAGE_PORT}/${PS_STORAGE_DATABASE}

# 客户端 JWT 签名的对称密钥（HS256，base64url，32 字节）—— 自行生成，切勿提交真实值
PS_CLIENT_AUTH_KEY=changethis
